import json
import os
import shlex
import traceback

{{ include('io_args.j2', ports=ports, node=node) }}

try:
    arg = {
        "name": "id",
        "type": "str",
        "value": "{{ node.id[:7] }}"
    }
    args.append(arg)
    # Crate a folder with the node id if it doesn't exist in /tmp
    tmp_dir = '/tmp/{{ node.id[:7] }}'
    if not os.path.exists(tmp_dir):
        os.makedirs(tmp_dir)
    with open(tmp_dir + '/' + 'inputs.json', 'w') as f:
        json.dump(args, f)

    # Convert to flat arguments
    inputs = ''
    for arg in args:
      name = arg.get('name')
      value = arg.get('value')
      type = arg.get('type')
      print(f"Processing argument: name={name}, value={value}")
      if type == 'list':
        value = value.strip()
      if type == 'str':
         value = f"'{value}'"
      line = f"--{name}={shlex.quote(value)}"
      print(f"Converted to flat argument: {line}")
      inputs += line + ' '

    with open(tmp_dir+'/inputs.txt', "wb") as f:
        for arg in args:
            name = arg.get('name')
            value = arg.get('value')
            var_type = arg.get('type')
            print(f"Writing argument to file: name={name}, value={value}, type={var_type}")
            if name and value:
                if var_type == 'list':
                    value = value.replace(' ','')
                    try:
                        json.loads(value)
                    except json.decoder.JSONDecodeError as err:
                        # It is a list[str]. We must save it as ["elm1","elem2",..]

                        value = json.dumps(json.loads(value.replace("'",'"')))
                if var_type == 'str' and ' ' in value:
                    # Escape exiting "
                    value = value.replace('"', '\\"')
                    value = '"'+value+'"'
                line = f'--{name}={value}'
                f.write(line.encode() + b"\0")
except Exception as e:
    print("Error in init container logic:")
    traceback.print_exc()