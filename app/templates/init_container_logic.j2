import json
import os
import shlex
import traceback


def _print_mount_contents(path):
    if not os.path.exists(path):
        print(f"- {path}: missing")
        return
    if not os.path.isdir(path):
        print(f"- {path}: exists but is not a directory")
        return

    try:
        entries = sorted(os.listdir(path))
    except OSError as err:
        print(f"- {path}: unreadable ({err})")
        return

    print(f"- {path}: {len(entries)} item(s)")
    for name in entries:
        print(f"    - {name}")


print("Volume mounts and their contents:")
for _mount_path in ["/workspace", "/tmp/data", "/tmp"]:
    _print_mount_contents(_mount_path)

{% set id_suffix = '-' + node.id[:7] %}
{% set title = node.properties.cell.title[:(62 - (id_suffix | length))] + id_suffix %}

try:
    args = []
    path = None
    # node.properties.parameters
    {% for parameter in node.properties.parameters %}
    {% if  parameter.to_task == title %}
    input_parameter_name = '{{ parameter.input_parameter_name }}'.replace('_{{ node.id[:7] }}', '')
    input_parameter_value = {{ parameter.input_parameter_value }}
    input_parameter_type = '{{ parameter.type }}'
    if isinstance(input_parameter_value, dict) and 'type' in input_parameter_value and input_parameter_value['type'] == 'ref':
        ref_path = input_parameter_value['value']
        print(f"Input parameter {input_parameter_name} is a reference. Looking for file at {ref_path}.")
        if os.path.exists(ref_path):
            with open(ref_path) as f:
                ref_input_parameter = json.load(f)
            input_parameter_value = ref_input_parameter['value']
            input_parameter_type = ref_input_parameter['type']
        else:
            print(f"Reference file {ref_path} does not exist. Using the original value.")
    print("type:", type(input_parameter_value))

    {% for port in ports.values() %}
    {% if port.type == 'right' %}
    path = "/tmp/{{ port.id }}_{{ node.id[:7] }}.json"
    {% endif %}
    {% endfor %}
    arg = {
       "name": input_parameter_name,
       "type": input_parameter_type,
       "value": str(input_parameter_value),
       "path": path
    }
    args.append(arg)
    {% endif %}
    {% endfor %}
    # node.properties.artifacts
    {% for artifact in node.properties.artifacts %}
    {% if artifact.to_task == title %}
    input_parameter_name = '{{ artifact.input_parameter_name }}'.replace('_{{ node.id[:7] }}', '')
    path = "/tmp/{{ artifact.name }}.json"
    if not os.path.exists(path):
        path = "/workspace/{{ artifact.name }}.json"
    with open(path) as f:
        input_parameter_value = json.load(f)
    input_parameter_type = '{{ artifact.type }}'
    {% for port in ports.values() %}
    {% if port.type == 'right' %}
    path = "/tmp/{{ port.id }}_{{ node.id[:7] }}.json"
    {% endif %}
    {% endfor %}
    arg = {
       "name": input_parameter_name,
       "type": input_parameter_type,
       "value": str(input_parameter_value),
       "path": path
    }
    args.append(arg)
    {% endif %}
    {% endfor %}

    arg = {
        "name": "id",
        "type": "str",
        "value": "{{ node.id[:7] }}"
    }
    args.append(arg)
    # Crate a folder with the node id if it doesn't exist in /workspace
    workspace_dir = '/workspace/{{ node.id[:7] }}'
    if not os.path.exists(workspace_dir):
        os.makedirs(workspace_dir)
    with open(workspace_dir + '/' + 'inputs.json', 'w') as f:
        json.dump(args, f)

    # Convert to flat arguments
    inputs = ''
    for arg in args:
      name = arg.get('name')
      value = arg.get('value')
      type = arg.get('type')
      print(f"Processing argument: name={name}, value={value}")
      if type == 'list':
        value = value.strip()
      if type == 'str':
         value = f"'{value}'"
      line = f"--{name}={shlex.quote(value)}"
      print(f"Converted to flat argument: {line}")
      inputs += line + ' '

    with open(workspace_dir+'/inputs.txt', "wb") as f:
        for arg in args:
            name = arg.get('name')
            value = arg.get('value')
            var_type = arg.get('type')
            if name and value:
                if var_type == 'list':
                    value = value.replace(' ','')
                    try:
                        json.loads(value)
                    except json.decoder.JSONDecodeError as err:
                        # It is a list[str]. We must save it as ["elm1","elem2",..]
                        value = json.dumps(json.loads(value.replace("'",'"')))
                if var_type == 'str' and ' ' in value:
                    # Escape exiting "
                    value = value.replace('"', '\\"')
                    value = '"'+value+'"'
                line = f'--{name}={value}'
                f.write(line.encode() + b"\0")
except Exception as e:
    print("Error in init container logic:")
    traceback.print_exc()