import json
import os
{% set id_suffix = '-' + node.id[:7] %}
{% set title = node.type[:(62 - (id_suffix | length))] + id_suffix %}
default_max_branches = {{ default_max_branches }}
param_max_branches = default_max_branches

args = []

# node.properties.parameters
{% for parameter in node.properties.parameters %}
{% if  parameter.to_task == title %}
input_parameter_name = '{{ parameter.input_parameter_name }}'.replace('_{{ node.id[:7] }}', '')
input_parameter_value = {{ parameter.value }}
input_parameter_type = '{{ parameter.type }}'
{% for port in ports.values() %}
{% if port.type == 'right' %}
path = "/tmp/{{ port.id }}_{{ node.id[:7] }}.json"
{% endif %}
{% endfor %}
arg = {
   "name": input_parameter_name,
   "type": input_parameter_type,
   "value": str(input_parameter_value),
   "path": path
}
args.append(arg)
{% endif %}
{% endfor %}

# node.properties.artifacts
{% for artifact in node.properties.artifacts %}
{% if artifact.to_task == title %}
input_parameter_name = '{{ artifact.name }}'
path = "/tmp/" + input_parameter_name + ".json"
if not os.path.exists(path):
    path = "/workspace/" + input_parameter_name + ".json"
with open(path) as f:
    input_parameter_value = json.load(f)
input_parameter_type = '{{ artifact.type }}'
{% for port in ports.values() %}
{% if port.type == 'right' %}
path = "/tmp/{{ port.id }}_{{ node.id[:7] }}.json"
{% endif %}
{% endfor %}

arg = {
   "name": input_parameter_name,
   "type": input_parameter_type,
   "value": str(input_parameter_value),
   "path": path
}
args.append(arg)
{% endif %}
{% endfor %}

for arg in args:
    if arg['name'] == 'param_max_branches':
        param_max_branches = int(arg['value'])
    else:
        var_name = arg['name']
        var_value = arg['value']
        var_type = arg['type']
        if var_type == 'list':
            var_value = json.loads(var_value.replace("'", '"'))
        globals()[var_name] = var_value
        max_branches = min(len(var_value), param_max_branches, default_max_branches)
        items_per_worker = len(var_value) // param_max_branches
        overflow = len(var_value) % param_max_branches
        list_of_lists = []
        for i in range(max_branches):
            chunk = items_per_worker
            if i < overflow:
                chunk = items_per_worker + 1
                start = i * chunk
            else:
                start = (i * chunk) + overflow
            end = start + chunk
            list_of_lists.append(var_value[start:end])

        file_name = os.path.splitext(os.path.basename(path))[0]
        output_base = f"/workspace/{file_name}"
        list_of_lists_path = f"{output_base}_list_of_lists.json"
        chunk_file_paths = []
        for idx, sublist in enumerate(list_of_lists):
            chunk_path = f"{output_base}_{idx}.json"
            print(f"Writing chunk {idx} to {chunk_path} with {len(sublist)} items.")
            with open(chunk_path, "w") as chunk_out:
                chunk_out.write(json.dumps(sublist))
            chunk_file_paths.append(chunk_path)

        print(f"Writing list of lists to {list_of_lists_path} with {len(list_of_lists)} sublists.")
        with open(list_of_lists_path, "w") as list_out:
            list_out.write(json.dumps(list_of_lists))

        f_out = open(arg['path'], "w")
        f_out.write(json.dumps(chunk_file_paths))
        f_out.close()