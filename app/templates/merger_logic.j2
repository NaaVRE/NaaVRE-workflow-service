for arg in args:
    var_name = arg['name']
    var_value = arg['value']
    var_type = arg['type']
    if var_type == 'list':
        parsed_items = ast.literal_eval(var_value)
        lst = []
        for idx, item in enumerate(parsed_items):
            print(f"  Parsing list item {idx}: {item}")
            print(f"  Type of item: {type(item)}")
            if isinstance(item, str):
                try:
                    parsed_item = json.loads(item)
                except json.JSONDecodeError:
                    print(f"  Failed to parse item as JSON: {item}")
                    parsed_item = item
            else:
                parsed_item = item
            lst.append(parsed_item)
        var_value = lst
    list_of_lists = var_value
    flat_list = []
    if isinstance(list_of_lists, str):
        list_of_lists = json.loads(list_of_lists)
    for sublist in list_of_lists:
        if isinstance(sublist, list):
            flat_list.extend(sublist)
        else:
            if isinstance(sublist, str):
                try:
                    parsed = json.loads(sublist)
                    if isinstance(parsed, list):
                        flat_list.extend(parsed)
                    else:
                        flat_list.append(parsed)
                except json.JSONDecodeError:
                    flat_list.append(sublist)
        f_out = open(arg['path'], "w")
        f_out.write(json.dumps(flat_list))
        f_out.close()