entrypoint: {{ workflow_name }}
serviceAccountName: {{ workflow_service_account }}
{% if cron_schedule %}
volumes:
{% for vol in extraVolumeMounts %}
- name: {{ vol.name }}
  persistentVolumeClaim:
    claimName: {{ vol.name }}
{% endfor %}
{% endif %}
volumeClaimTemplates:
- metadata:
    name: workdir
  spec:
    accessModes: [ "ReadWriteMany" ]
    persistentVolumeReclaimPolicy: Delete
    resources:
      requests:
        storage: {{ workdir_storage_size }}
arguments:
  parameters:
  {% for payload_param in naavrewf2_payload_params %}
  - name: {{ payload_param.name }}_{{ payload_param.node_id[:7] }}
    value:  "{{ payload_param.value | replace('"', "'") }}"
  {% endfor %}
templates:
- name: {{ workflow_name }}
  dag:
    tasks:
    {% for node in nodes.values() %}
    {% set is_splitter = node.type == 'splitter' %}
    {% set is_merger = node.type == 'merger' %}
    {% set is_fdo_writer = node.type == 'fdo-writer' %}
    {% set is_special_node = is_splitter or is_merger or is_fdo_writer %}
    {% set title =  node.type + "-" + node.id[:7] if is_special_node else node.properties.cell.title+ "-" + node.id[:7] %}
    - name: {{ title }}
      {% if dependencies_dag[node.id]|length > 0 %}
      dependencies: [{% for d in dependencies_dag[node.id] %} {{ d.task_name }}{% if not loop.last %},{% endif %} {% endfor %}]
      {% endif %}
      template: {{ title }}-tmp
      arguments:
      {% if node.properties.artifacts %}
        artifacts:
        {% for artifact in node.properties.artifacts %}
        {% if title == artifact.to_task %}
        - name: {{ artifact.name }}
          from: {{ artifact.from }}
        {% endif %}
        {% endfor %}
      {% endif %}
      {% if node.properties.parameters %}
        parameters:
        {% for parameter in node.properties.parameters %}
        {% if title == parameter.to_task %}
        - name: {{ parameter.name }}
          value: {{ parameter.value }}
        {% endif %}
      {% if parameter.withParam is defined and title == parameter.to_task %}
      withParam: {{ parameter.withParam }}
      {% endif %}
        {% endfor %}
      {% endif %}
    {% endfor %}
{% for node in nodes.values() %}
{% set is_splitter = node.type == 'splitter' %}
{% set is_merger = node.type == 'merger' %}
{% set is_fdo_writer = node.type == 'fdo-writer' %}
{% set is_special_node = is_splitter or is_merger or is_fdo_writer %}
{% set title = node.type + "-" + node.id[:7] if is_special_node else node.properties.cell.title + "-" + node.id[:7] %}
{% set secrets = [] if is_special_node else node.properties.cell.secrets %}
{% set ports = node.ports %}
- name: {{ title }}-tmp
  inputs:
    {% if node.properties.parameters %}
    parameters:
    {% for parameter in node.properties.parameters %}
    {% if title == parameter.to_task %}
    - name: {{ parameter.name }}
    {% endif %}
    {% endfor %}
    {% endif %}
    {% if node.properties.artifacts %}
    artifacts:
    {% for artifact in node.properties.artifacts %}
    {% if title == artifact.to_task %}
    - name: {{ artifact.name }}
      path: /tmp/{{ artifact.name }}.json
    {% endif %}
    {% endfor %}
    {% endif %}
    {# fdo-writer is a sink: it has no output ports. Argo rejects a template
    with an empty `outputs.parameters` list, so only emit the block when at
    least one output port exists. #}
    {% set ns = namespace(has_outputs=false) %}
    {% for port in ports.values() %}
    {% if port.type == 'right' %}{% set ns.has_outputs = true %}{% endif %}
    {% endfor %}
    {% if ns.has_outputs %}
  outputs:
    {% if node.properties.parameters %}
    parameters:
    {% for parameter in node.properties.parameters %}
    {% if title == parameter.from_task %}
    - name: {{ parameter.name }}
      valueFrom:
        path: /tmp/{{ parameter.name }}.json
    {% endif %}
    {% endfor %}
    {% endif %}
    {% if node.properties.artifacts %}
    artifacts:
    {% for artifact in node.properties.artifacts %}
    {% if title == artifact.from_task %}
    - name: {{ artifact.name }}
      path: /tmp/{{ artifact.name }}.json
    {% endif %}
    {% endfor %}
    {% endif %}
    {% endif %}
  {% if is_fdo_writer %}
  {% set special_dep = dependencies_dag[node.id][0] %}
  script:
    image: python:3.11-alpine
    imagePullPolicy: IfNotPresent
    command: [python]
    source: |
      {{ include('fdo_writer_logic.j2', ports=ports, special_dep=special_dep, node=node) | indent(6) }}
  {% elif is_splitter or is_merger %}
  {% set special_dep = dependencies_dag[node.id][0] %}
  volumeMounts:
    - name: workspace
      mountPath: /workspace
  script:
    image: python:alpine3.9
    imagePullPolicy: IfNotPresent
    command: [python]
    source: |
      {% if is_splitter %}
      {{ include('splitter_logic.j2', ports=ports, special_dep=special_dep, node=node, naavrewf2_payload_params=naavrewf2_payload_params, default_max_branches=default_max_branches,shared_dir_mount=shared_dir_mount) | indent(6) }}
      {% else %}
      {{ include('merger_logic.j2', ports=ports, special_dep=special_dep,node=node,shared_dir_mount=shared_dir_mount) | indent(6) }}
      {% endif %}
  {% else %}
  container:
    image: "{{ node.properties.cell.container_image }}"
    imagePullPolicy: Always
    env:
    {%  for s in secrets %}
    - name: {{ s.name }}
      valueFrom:
         secretKeyRef:
           name: {{ k8s_secret_name }}
           key: {{ s.name }}
    {%  endfor %}
    command: ["/bin/bash", "-c"]
    args:
      - |
        source /venv/bin/activate;
        cat <<'PY' > /tmp/init_input_args.py
        {{ include('init_container_logic.j2', ports=ports,node=node,shared_dir_mount=shared_dir_mount) | indent(8) }}
        PY
        python /tmp/init_input_args.py;
        {% set inputs_dir = '/tmp/' ~ node.id[:7] %}
        {% if node.properties.cell.kernel == 'ipython' %}
        {% set cmd = 'python /app/task.py' %}
        {% elif node.properties.cell.kernel == 'IRkernel' %}
        {% set cmd = 'Rscript /app/task.R' %}
        {% endif %}
        {%  if  node.properties.cell.json_args_supported %}
        cat /tmp/{{ node.id[:7] }}/inputs.json;
        {{  cmd }} --args_json /tmp/{{ node.id[:7] }}/inputs.json;
        {%  elif node.properties.cell.kernel == 'ipython' %}
        python -c 'import os,sys,runpy; sys.argv=["/app/task.py"]+[os.fsdecode(a) for a in open("{{ inputs_dir }}/inputs.txt","rb").read().split(b"\0") if a]; sys.path.insert(0,"/app"); runpy.run_path("/app/task.py", run_name="__main__")'
        {%  elif node.properties.cell.kernel == 'IRkernel' %}
        Rscript -e 'f<-"{{ inputs_dir }}/inputs.txt"; r<-readBin(f,"raw",file.size(f)); z<-c(0,which(r==as.raw(0)),length(r)+1); a<-unlist(lapply(seq_len(length(z)-1),function(i) if(z[i+1]-z[i]>1) rawToChar(r[(z[i]+1):(z[i+1]-1)]))); unlockBinding("commandArgs",baseenv()); assign("commandArgs",function(trailingOnly=FALSE) if(trailingOnly) a else c("R","--no-echo","--no-restore","--file=/app/task.R","--args",a),envir=baseenv()); source("/app/task.R")'
        {%  endif %}
  {% endif %}
    volumeMounts:
    - name: workdir
      mountPath: {{ shared_dir_mount }}
    {% for vol in extraVolumeMounts %}
    - name: {{ vol.name }}
      mountPath: {{ vol.mountPath }}
      {% if vol.subPath is defined %}
      subPath: {{ vol.subPath }}
      {% endif %}
      {% if vol.readOnly is defined %}
      readOnly: {{ vol.readOnly }}
      {% endif %}
    {% endfor %}
{% endfor %}